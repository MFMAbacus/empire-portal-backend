{
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "**/*.test.ts"
  ],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "collectCoverageFrom": [
    "**/*.ts",
    "!**/*.d.ts",
    "!**/index.ts"
  ],
  "coverageReporters": [
    "lcov"
  ]
}
